{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 2
    },
    "kind": {
      "type": "string",
      "const": "guide"
    },
    "guide": {
      "type": "object",
      "properties": {
        "referenceLapTime": {
          "type": ["string", "null"]
        },
        "setupNotes": {
          "type": ["string", "null"]
        }
      }
    },
    "corners": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "cornerNumber": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "brakeReference": {
            "type": ["string", "null"]
          },
          "brakeMarkerMeters": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "entrySpeedKmh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "minSpeedKmh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "exitSpeedKmh": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ]
          },
          "gear": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "turnIn": {
                    "type": ["string", "null"]
                  },
                  "apex": {
                    "type": ["string", "null"]
                  },
                  "exit": {
                    "type": ["string", "null"]
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "throttleNotes": {
            "type": ["string", "null"]
          },
          "trailBrakeNotes": {
            "type": ["string", "null"]
          },
          "priority": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["entry", "balanced", "exit"]
              },
              {
                "type": "null"
              }
            ]
          },
          "brakePressure": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["none", "light", "firm", "heavy"]
              },
              {
                "type": "null"
              }
            ]
          },
          "brakePressurePct": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ]
          },
          "cue": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              {
                "type": "null"
              }
            ]
          },
          "downshiftTo": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": ["string", "null"]
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string",
                "enum": ["low", "medium", "high"]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["cornerNumber"]
      }
    }
  },
  "required": ["schemaVersion", "kind", "guide", "corners"]
}
